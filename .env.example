# Example Environment Configuration for Trinetra Agro AI
# Copy this to .env and replace with your actual API keys

# OpenRouter API Configuration (REQUIRED for advanced AI chat)
# Get your API key from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Available models (choose one):
# - openai/gpt-4-turbo-preview (Recommended)
# - openai/gpt-3.5-turbo (Cost-effective)
# - anthropic/claude-3-haiku (Alternative)
# - meta-llama/llama-3.1-8b-instruct (Budget option)
OPENROUTER_MODEL=openai/gpt-4-turbo-preview

# OpenAI API (Alternative to OpenRouter)
OPENAI_API_KEY=your_openai_api_key_here

# Weather API
# Get free API key from: https://openweathermap.org/api
WEATHER_API_KEY=your_weather_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///trinetra.db

# Application Settings
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=trinetra_secret_key_2024_change_in_production

# Optional: Market Data APIs
MARKET_DATA_API_KEY=your_market_api_key_here

# Optional: Government Agricultural Data
GOV_DATA_API_KEY=your_gov_api_key_here