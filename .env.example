# Example Environment Configuration for Trinetra Agro AI
# Copy this to .env and replace with your actual API keys

# OpenRouter API Configuration (REQUIRED for advanced AI chat)
# Get your API key from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Available models (choose one):
# - openai/gpt-4-turbo-preview (Recommended)
# - openai/gpt-3.5-turbo (Cost-effective)
# - anthropic/claude-3-haiku (Alternative)
# - meta-llama/llama-3.1-8b-instruct (Budget option)
OPENROUTER_MODEL=openai/gpt-4-turbo-preview

# OpenAI API (Alternative to OpenRouter)
OPENAI_API_KEY=your_openai_api_key_here

# Weather API
# Get free API key from: https://openweathermap.org/api
WEATHER_API_KEY=your_weather_api_key_here

# Database Configuration
# Local default: sqlite:///data/trinetra.db
# Production example (PostgreSQL): postgresql+psycopg2://user:password@host:5432/trinetra
DATABASE_URL=sqlite:///data/trinetra.db

# Application Settings
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change_this_to_a_long_random_secret

# Optional runtime settings (used by deployment command)
PORT=8501

# Security settings (recommended for public deployment)
REQUIRE_LOGIN=false
AUTH_USERNAME=admin
# Generate with: python -c "import hashlib; print(hashlib.sha256('strong-password'.encode()).hexdigest())"
AUTH_PASSWORD_HASH=

# Chat abuse guard (seconds between chat requests per session)
CHAT_MIN_INTERVAL_SEC=2

# Optional admin operations dashboard (shows event counters/logs)
ENABLE_OPERATIONS_DASHBOARD=false

# Optional: Market Data APIs
MARKET_DATA_API_KEY=your_market_api_key_here

# Optional: Government Agricultural Data
GOV_DATA_API_KEY=your_gov_api_key_here
