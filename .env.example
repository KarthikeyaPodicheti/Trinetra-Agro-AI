# Example Environment Configuration for Trinetra Agro AI
# Copy this to .env and replace with your actual API keys

# OpenRouter API Configuration (REQUIRED for advanced AI chat)
# Get your API key from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Available models (choose one):
# - openai/gpt-4-turbo-preview (Recommended)
# - openai/gpt-3.5-turbo (Cost-effective)
# - anthropic/claude-3-haiku (Alternative)
# - meta-llama/llama-3.1-8b-instruct (Budget option)
OPENROUTER_MODEL=openai/gpt-4-turbo-preview

# OpenAI API (Alternative to OpenRouter)
OPENAI_API_KEY=your_openai_api_key_here

# Weather API
# Get free API key from: https://openweathermap.org/api
WEATHER_API_KEY=your_weather_api_key_here

# Mandi market data API key
# Get key from: https://data.gov.in/
MARKET_DATA_API_KEY=your_market_data_api_key_here

# Database Configuration
# Local default: sqlite:///data/trinetra.db
# Production example (PostgreSQL): postgresql+psycopg2://user:password@host:5432/trinetra
# Supabase (recommended format): postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///data/trinetra.db

# Optional explicit Supabase metadata (for docs/ops only)
SUPABASE_PROJECT_REF=
SUPABASE_REGION=

# Application Settings
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change_this_to_a_long_random_secret

# Optional runtime settings (used by deployment command)
PORT=8501

# Security settings (recommended for public deployment)
REQUIRE_LOGIN=false
AUTH_MODE=password
AUTH_USERNAME=admin
# Generate with: python -c "import hashlib; print(hashlib.sha256('strong-password'.encode()).hexdigest())"
AUTH_PASSWORD_HASH=

# OTP mode settings (AUTH_MODE=otp)
# OTP delivery webhook receives JSON: {phone, otp, message, sender}
OTP_WEBHOOK_URL=
OTP_WEBHOOK_BEARER_TOKEN=
OTP_SENDER_NAME=Trinetra Agro AI
OTP_EXPIRY_SEC=300
OTP_RESEND_INTERVAL_SEC=45
OTP_MAX_ATTEMPTS=5
# Keep false in production. true allows showing OTP in UI when webhook is not configured.
OTP_ALLOW_DEV_FALLBACK=false

# OTP webhook gateway (if you self-host otp_gateway.py)
OTP_PROVIDER=console
OTP_GATEWAY_HOST=0.0.0.0
OTP_GATEWAY_PORT=8081
OTP_WEBHOOK_PATH=/send-otp
OTP_GATEWAY_BEARER_TOKEN=

# Fast2SMS settings (OTP_PROVIDER=fast2sms)
FAST2SMS_API_KEY=

# Twilio settings (OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Production runner observability
RUNNER_METRICS_HOST=127.0.0.1
RUNNER_METRICS_PORT=9090
RUNNER_LOG_MAX_BYTES=5242880
RUNNER_LOG_BACKUP_COUNT=5
RUNNER_LOG_RETENTION_DAYS=7

# Input validation safety limits
MAX_IMAGE_MB=5

# Prediction safety threshold (0.0 - 1.0)
SAFETY_CONFIDENCE_THRESHOLD=0.70

# Chat abuse guard (seconds between chat requests per session)
CHAT_MIN_INTERVAL_SEC=2

# Optional admin operations dashboard (shows event counters/logs)
ENABLE_OPERATIONS_DASHBOARD=false

# Optional: Government Agricultural Data
GOV_DATA_API_KEY=your_gov_api_key_here
